# X (Twitter) API credentials for the prototype-publishing pipeline.
# Copy this file to `.env` (same dir) and fill in the 4 values. `.env` is gitignored —
# never commit real keys.
#
# How to get these (≈5 min, one time):
#   1. Go to https://developer.x.com/ and sign in with the account you'll post from.
#   2. Sign up for the Free tier if prompted (enough to post + upload a GIF).
#   3. In the Developer Portal: create a Project, then an App inside it.
#   4. App → "User authentication settings" → set App permissions to **Read and Write**. Save.
#   5. App → "Keys and tokens":
#        - Under "Consumer Keys" → copy API Key + API Key Secret            -> X_API_KEY / X_API_SECRET
#        - Under "Authentication Tokens" → "Access Token and Secret" →
#          **Generate** (must be AFTER step 4, or it'll be read-only) →
#          copy both                                                        -> X_ACCESS_TOKEN / X_ACCESS_SECRET
#   6. Paste below, save as `.env`, then run:  node tweet.mjs --check

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional — the handle you post from (no @), used only for the auth-check readout.
X_HANDLE=

# Optional — set to true to REAL-post to X automatically on every `/post-prototype` publish.
# X's API charges ~$0.20 per post that contains a link, so this spends real credits — keep an
# X spending cap set. Leave blank to instead stage a $0 draft (text + GIF in .tmp/) for manual posting.
X_AUTOPOST=
